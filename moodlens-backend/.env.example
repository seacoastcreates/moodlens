DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/moodlens

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

# Signs per-device history tokens (see /register in main.py). Separate secret
# from API_KEY so rotating one doesn't invalidate the other. Generate the
# same way: python -c "import secrets; print(secrets.token_urlsafe(32))"
TOKEN_SECRET=change-me-too
